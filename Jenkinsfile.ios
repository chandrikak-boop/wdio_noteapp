pipeline {
    agent any

    environment {
        // Use the NodeJS installation you added in Jenkins
        NODEJS_HOME = tool name: 'node20', type: 'NodeJS'
        PATH = "${env.NODEJS_HOME}/bin:${env.PATH}"
        ANDROID_HOME = '/Users/testvagranttechnologies/Library/Android/sdk' // optional, can skip for pure iOS
    }

    stages {

        stage('Checkout SCM') {
            steps {
                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                sh 'npm install'
                // or 'npm ci' if your package-lock.json is in sync
            }
        }

        stage('Verify Xcode') {
            steps {
                sh 'xcode-select -p'
                sh 'xcodebuild -version'
            }
        }

        stage('Run WDIO iOS Tests') {
            steps {
                sh 'npx wdio config/wdio.ios.conf.ts'
            }
        }
    }

    post {
        always {
            // archive test reports (JUnit XML format)
            archiveArtifacts artifacts: '**/reports/*.xml', allowEmptyArchive: true
            junit '**/reports/*.xml'
        }
        failure {
            echo 'iOS tests failed!'
        }
        success {
            echo 'iOS tests passed successfully!'
        }
    }
}
