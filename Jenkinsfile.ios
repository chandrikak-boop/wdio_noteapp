pipeline {
    agent any

    environment {
        ANDROID_HOME = '/Users/testvagranttechnologies/Library/Android/sdk' // optional
        NODE_VERSION = '20.19.0' // NodeJS version
    }

    stages {

        stage('Checkout SCM') {
            steps {
                checkout scm
            }
        }

        stage('Install NodeJS') {
            steps {
                // Install nvm if not present, then install NodeJS
                sh '''
                if [ -z "$NVM_DIR" ]; then
                  export NVM_DIR="$HOME/.nvm"
                  mkdir -p "$NVM_DIR"
                  curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.39.7/install.sh | bash
                fi
                export NVM_DIR="$HOME/.nvm"
                [ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"
                nvm install ${NODE_VERSION}
                nvm use ${NODE_VERSION}
                node -v
                npm -v
                '''
            }
        }

        stage('Install Dependencies') {
            steps {
                sh 'npm install'
            }
        }

        stage('Verify Xcode') {
            steps {
                sh 'xcode-select -p'
                sh 'xcodebuild -version'
            }
        }

        stage('Run WDIO iOS Tests') {
            steps {
                sh 'npx wdio config/wdio.ios.conf.ts'
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: '**/reports/*.xml', allowEmptyArchive: true
            junit '**/reports/*.xml'
        }
        failure {
            echo 'iOS tests failed!'
        }
        success {
            echo 'iOS tests passed successfully!'
        }
    }
}
