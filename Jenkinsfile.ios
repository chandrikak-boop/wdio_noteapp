pipeline {
    agent any

    environment {
        // Use the NodeJS installation you added in Jenkins
        NODEJS_HOME = tool name: 'node20', type: 'NodeJS'
        PATH = "${env.NODEJS_HOME}/bin:${env.PATH}"
        ANDROID_HOME = '/Users/testvagranttechnologies/Library/Android/sdk' // optional, can skip for pure iOS
    }

    stages {

        stage('Checkout SCM') {
            steps {
                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                sh 'npm install'
                // or 'npm ci' if your package-lock.json is in sync
            }
        }

        stage('Verify Xcode') {
            steps {
                sh 'xcode-select -p'
